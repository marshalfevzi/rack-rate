---
import {
  LISTING_COPY,
  type CostBasisKind,
  type PrimitiveState,
} from "../lib/provenance.ts"

interface Props {
  label: string
  basis?: CostBasisKind
  active?: boolean
  state?: PrimitiveState
  reason?: string
  class?: string
}

const { label, basis, active = false, state = "default", reason, class: className } = Astro.props

const stateText =
  state === "loading"
    ? `${label} · Loading`
    : state === "empty"
      ? LISTING_COPY.empty
      : state === "error"
        ? `${label} · ${reason ?? LISTING_COPY.empty}`
        : label

const isActivePlanRoute = active && basis === "plan-route" && state !== "disabled"
---

<span
  class:list={[
    "inline-flex items-center border px-2 py-1 font-mono text-micro uppercase",
    state === "disabled"
      ? "border-rule text-dim opacity-60"
      : state === "loading" || state === "empty" || state === "error"
        ? "border-rule text-dim"
        : "border-rule text-ink",
    isActivePlanRoute ? "border-signal bg-[var(--signal-plate)] text-on-signal" : null,
    className,
  ]}
  data-basis={basis}
  data-state={state}
  aria-disabled={state === "disabled" ? "true" : undefined}
>
  {stateText}
</span>

<style>
  [data-basis="plan-route"] {
    border-style: solid;
    border-width: 1px;
  }

  [data-basis="api-list"] {
    border-color: color-mix(in srgb, var(--color-ink) 50%, transparent);
    border-inline-end-color: transparent;
    border-style: solid;
    border-width: 1px;
  }

  [data-basis="aa-index"] {
    border-style: double;
    border-width: 3px;
  }
</style>
