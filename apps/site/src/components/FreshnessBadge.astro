---
import Badge from "./Badge.astro"
import { FRESHNESS_TERMS, type Freshness } from "../lib/provenance.ts"

interface Props {
  freshness: Freshness
  retrievedAt: string
}

const { freshness, retrievedAt } = Astro.props

const term = FRESHNESS_TERMS[freshness]
---

<Badge title={`${term.description} Retrieved ${retrievedAt}.`}>
  {term.label}
  <span class="tabular">retrieved {retrievedAt}</span>
</Badge>
