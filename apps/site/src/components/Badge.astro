---
import { LISTING_COPY, type PrimitiveState } from "../lib/provenance.ts"

interface Props {
  title?: string
  state?: PrimitiveState
  reason?: string
  class?: string
}

const { title, state = "default", reason, class: className } = Astro.props

const stateText =
  state === "loading"
    ? "Loading"
    : state === "empty"
      ? LISTING_COPY.empty
      : state === "error"
        ? reason ?? LISTING_COPY.empty
        : null
---

<span
  class:list={[
    "inline-flex items-baseline gap-1 border border-rule px-1.5 py-0.5 font-mono text-meta uppercase",
    state === "disabled" ? "text-dim opacity-60" : state === "loading" ? "text-dim" : "text-ink",
    className,
  ]}
  data-state={state}
  aria-disabled={state === "disabled" ? "true" : undefined}
  title={title}
>
  {stateText ?? <slot />}
</span>
