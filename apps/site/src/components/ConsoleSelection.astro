---
import ControlRow from "./ControlRow.astro"
import SectionHead from "./SectionHead.astro"
import { LISTING_COPY } from "../lib/provenance.ts"
import type { ConsoleSelectionModel } from "../lib/console-data.ts"

interface Props {
  plans: Array<{ id: string; name: string }>
  defaultPlanId: string
  models: ConsoleSelectionModel[]
  defaultModelId: string
  defaultTasks: number
  tasksStep: number
}

const { plans, defaultPlanId, models, defaultModelId, defaultTasks, tasksStep } = Astro.props
---

<section aria-labelledby="selection-heading">
  <SectionHead id="selection-heading" title="SELECT" as="h3" />
  <div class="mt-4 space-y-3">
    <ControlRow label="Plan">
      <label for="console-plan" class="sr-only">Plan</label>
      <select
        id="console-plan"
        class="min-w-0 max-w-full border border-rule bg-panel px-2 py-2 font-sans text-body text-ink transition-colors duration-150 ease-standard"
      >
        {plans.map((plan) => <option value={plan.id} selected={plan.id === defaultPlanId}>{plan.name}</option>)}
      </select>
    </ControlRow>

    <ControlRow label="Models">
      <fieldset id="console-model-options" class="flex min-w-0 flex-wrap gap-2" aria-label="Models">
        {models.map((model) => (
          <label
            for={`console-model-${model.modelId}`}
            class="console-model-toggle inline-flex min-h-11 max-w-full cursor-pointer items-center gap-2 border border-rule bg-panel px-2 py-1 font-mono text-micro text-ink transition-colors duration-150 ease-standard"
          >
            <input
              id={`console-model-${model.modelId}`}
              class="h-4 w-4 shrink-0 accent-signal"
              type="checkbox"
              value={model.modelId}
              checked={model.modelId === defaultModelId}
            />
            <span>{model.modelName}</span>
          </label>
        ))}
      </fieldset>
      <span id="console-model-empty" class="hidden font-sans text-meta text-dim">{LISTING_COPY.empty}</span>
    </ControlRow>

    <ControlRow label="Tasks per month">
      <label for="console-tasks" class="sr-only">Tasks per month</label>
      <input
        id="console-tasks"
        class="w-32 max-w-full border border-rule bg-panel px-2 py-2 font-mono text-data tabular text-ink transition-colors duration-150 ease-standard"
        type="number"
        min="0"
        step={tasksStep}
        value={defaultTasks}
      />
    </ControlRow>

    <ControlRow label="Reset">
      <button
        id="console-reset"
        type="button"
        class="border border-rule bg-panel px-3 py-2 font-sans text-body text-ink transition-colors duration-150 ease-standard hover:border-rule-strong active:bg-ink active:text-canvas"
      >
        Reset selection
      </button>
    </ControlRow>
  </div>
</section>

<template id="console-model-template">
  <label class="console-model-toggle inline-flex min-h-11 max-w-full cursor-pointer items-center gap-2 border border-rule bg-panel px-2 py-1 font-mono text-micro text-ink transition-colors duration-150 ease-standard">
    <input class="h-4 w-4 shrink-0 accent-signal" type="checkbox" data-console-model-input />
    <span data-console-model-name></span>
  </label>
</template>
