---
import Badge from "./Badge.astro"
import { CONFIDENCE_TERMS, type Confidence } from "../lib/provenance.ts"

interface Props {
  level: Confidence
}

const { level } = Astro.props

const term = CONFIDENCE_TERMS[level]
---

<Badge title={term.description}>
  <span class="sr-only">Confidence: </span>
  {term.label}
</Badge>
