---
import Badge from "./Badge.astro"
import { CONFIDENCE_TERMS, type Confidence, type PrimitiveState } from "../lib/provenance.ts"

interface Props {
  level: Confidence
  state?: PrimitiveState
  reason?: string
}

const { level, state = "default", reason } = Astro.props

const term = CONFIDENCE_TERMS[level]
---

<Badge state={state} reason={reason} title={term.description}>
  <span class="sr-only">Confidence: </span>
  {term.label}
</Badge>
