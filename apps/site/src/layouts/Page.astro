---
import Base from "./Base.astro"

interface Props {
  title: string
  description: string
  heading?: string
  lede?: string
}

const { title, description, heading, lede } = Astro.props
---

<Base title={title} description={description}>
  <main id="main" tabindex="-1" class="min-w-0 py-8">
    <h1 class="text-display">{heading ?? title}</h1>
    {lede ? <p class="text-body text-dim">{lede}</p> : null}
    <slot />
  </main>
</Base>
