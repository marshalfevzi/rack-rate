---
import "../styles/global.css"

import { Font } from "astro:assets"

import { absoluteUrl, asset } from "../lib/url.ts"

import StatusBand from "../components/StatusBand.astro"
import Readout from "../components/Readout.astro"
import LaneRail from "../components/LaneRail.astro"
import FooterIndex from "../components/FooterIndex.astro"

import { lanes, isCurrent } from "../lib/nav.ts"
import {
  apiFrontier,
  compositeByModel,
  derivedGeneratedAt,
  models,
  plans,
  sources,
  benchmarks,
  tokenAllowances,
} from "../lib/data.ts"
import {
  defaultReadout,
  shellStampReadouts,
  type ReadoutFields,
  type ShellStampReadouts,
} from "../lib/readout.ts"
import { artificialAnalysisState, newestRetrievedAt } from "../lib/provenance.ts"

interface Props {
  title: string
  description: string
  readout?: ReadoutFields
}

const { title, description, readout } = Astro.props

const current = lanes.find((lane) => isCurrent(Astro.url.pathname, lane.path))?.path ?? null

// surfaces.md defines BUILD as the committed generation date.
const buildDate = derivedGeneratedAt.slice(0, 10)

const dataDate = newestRetrievedAt(sources, models, plans, benchmarks)

const aaPublished = artificialAnalysisState(benchmarks).published

const stampReadouts: ShellStampReadouts = shellStampReadouts({
  buildDate,
  dataDate,
  benchmarks,
  sources,
})

const pageReadout =
  readout ??
  defaultReadout({
    pathname: Astro.url.pathname,
    models,
    plans,
    benchmarks,
    sources,
    tokenAllowances,
    apiFrontier,
    composites: [...compositeByModel.values()],
  })
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · rack-rate</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absoluteUrl(Astro.url.pathname, Astro.site)} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b0c0e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f5f6" media="(prefers-color-scheme: light)" />
    <link rel="icon" href={asset("/favicon.svg")} type="image/svg+xml" />
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" preload />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="rack-rate" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absoluteUrl(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={absoluteUrl(asset("/og.png"), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl(asset("/og.png"), Astro.site)} />
  </head>
  <body class="min-h-screen bg-canvas font-sans text-ink">
    <!-- In-page fragments bypass the helper. -->
    <a class="skip-link" href="#main">Skip to content</a>
    <StatusBand
      buildDate={buildDate}
      dataDate={dataDate}
      aaPublished={aaPublished}
      readouts={stampReadouts}
    />
    <Readout readout={pageReadout} />
    <div class="mx-auto w-full max-w-[1440px] px-6 md:px-8 lg:grid lg:grid-cols-[11rem_minmax(0,1fr)] lg:gap-x-8 lg:pl-0 lg:pr-8 xl:gap-x-12 xl:pr-12">
      <LaneRail lanes={lanes} current={current} buildDate={buildDate} dataDate={dataDate} />
      <slot />
    </div>
    <FooterIndex lanes={lanes} current={current} />
  </body>
</html>
