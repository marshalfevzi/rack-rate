---
import Page from "../layouts/Page.astro"
import ConsoleListing from "../components/ConsoleListing.astro"
import ConsoleSelection from "../components/ConsoleSelection.astro"
import ProvenanceIndexTable from "../components/ProvenanceIndexTable.astro"
import SectionHead from "../components/SectionHead.astro"
import { buildConsole } from "../lib/console-data.ts"
import { href } from "../lib/url.ts"

const console = buildConsole()
---

<Page
  title="Overview"
  description="Which model should I use, and which subscription pays for itself? Published benchmark scores joined to measured plan quotas, with every figure traceable to a source."
  heading="Which model should I use, and which plan pays for itself?"
  readout={console.initialReadout}
>
  <section class="mt-6" aria-labelledby="split-console-heading">
    <SectionHead id="split-console-heading" title="SPLIT CONSOLE" />
    <div class="mt-4 grid gap-8 min-[1024px]:grid-cols-[minmax(16rem,22.5rem)_minmax(0,1fr)]">
      <ConsoleSelection
        plans={console.plans}
        defaultPlanId={console.defaultPlanId}
        models={console.defaultModels}
        defaultModelId={console.defaultModelId}
        defaultTasks={console.defaultTasks}
        tasksStep={console.tasksStep}
      />
      <ConsoleListing
        rows={console.initialRows}
        readout={console.initialReadout}
        routeCount={console.initialRouteCount}
        largestMultiple={console.largestMultiple}
        setAside={console.setAside}
        payload={console.payload}
      />
    </div>
  </section>

  <ProvenanceIndexTable
    id="headline-index"
    title="HEADLINE INDEX"
    caption="Headline index with value, basis, confidence, source, and retrieved date."
    rows={console.headlineIndexRows}
  />

  <ProvenanceIndexTable
    id="headline-figures"
    title="HEADLINE FIGURES"
    caption="Committed counts and API-list frontier points."
    rows={console.headlineFigureRows}
  />

  <section class="mt-12" aria-labelledby="entry-points-heading">
    <SectionHead id="entry-points-heading" title="CONTINUE EXPLORING" />
    <nav aria-label="Continue exploring" class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-body">
      <a href={href("/models")} class="text-ink underline decoration-rule underline-offset-2">Models</a>
      <a href={href("/plans")} class="text-ink underline decoration-rule underline-offset-2">Plans</a>
      <a href={href("/compare")} class="text-ink underline decoration-rule underline-offset-2">Compare</a>
      <a href={href("/explore")} class="text-ink underline decoration-rule underline-offset-2">Explore</a>
      <a href={href("/method")} class="text-ink underline decoration-rule underline-offset-2">Method</a>
      <a href={href("/sources")} class="text-ink underline decoration-rule underline-offset-2">Sources</a>
    </nav>
  </section>

  <script>
    import { initConsole } from "../lib/console-client.ts"

    initConsole()
  </script>
</Page>
