{
  "name": "rack-rate",
  "version": "2.0.0",
  "private": true,
  "description": "Compare LLM models across benchmarks, and price coding subscriptions against API list rates.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @rack-rate/site dev",
    "build": "bun run data:build && bun run --filter @rack-rate/site build && bun run og",
    "preview": "bun run --filter @rack-rate/site preview",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run --filter @rack-rate/site check",
    "typecheck": "tsc --build --force",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "quality": "fallow",
    "test": "bun test --pass-with-no-tests",
    "fetch": "bun run --filter @rack-rate/data-cli cli -- fetch",
    "fetch:deepswe": "bun run --filter @rack-rate/data-cli cli -- fetch deepswe",
    "fetch:terminal-bench": "bun run --filter @rack-rate/data-cli cli -- fetch terminal-bench",
    "fetch:plans": "bun run --filter @rack-rate/data-cli cli -- fetch plans",
    "fetch:artificial-analysis": "bun run --filter @rack-rate/data-cli cli -- fetch artificial-analysis",
    "validate": "bun run --filter @rack-rate/data-cli cli -- validate",
    "compute": "bun run --filter @rack-rate/data-cli cli -- compute",
    "data:build": "bun run validate && bun run compute",
    "data:check": "bun run --filter @rack-rate/data-cli cli -- check",
    "og": "bun run --filter @rack-rate/site og"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.82.0",
    "@types/bun": "^1.4.2",
    "fallow": "3.25.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
